@{
    ViewData["Title"] = "Reset Account Access";
}

<div class="fox-split-wrapper">
    <!-- Left Side: Image -->
    <div class="fox-split-image" style="background-image: url('/images/design/login_page_fox.jpg');">
        <div class="fox-image-overlay">
            <h1 class="display-4 fw-bold mb-2">Need a new path?</h1>
            <p class="fs-4 opacity-90">Don't worry, even the smartest foxes lose their way sometimes.</p>
        </div>
    </div>

    <!-- Right Side: Form -->
    <div class="fox-split-form">
        <div class="fox-form-card shadow-lg">
            <div class="text-center mb-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                     style="width: 70px; height: 70px; background-color: var(--sky-blue-bg);">
                    <i class="bi bi-key-fill" style="font-size: 2rem; color: var(--sky-blue-dark);"></i>
                </div>
                <h2 class="fox-title">Forgot Password</h2>
                <p class="text-muted small">Enter your email and we'll send you a recovery link.</p>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                        <i class="bi bi-envelope text-muted"></i>
                    </span>
                    <input id="email" class="form-control border-2 border-start-0" 
                           placeholder="your@email.com" 
                           style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" />
                </div>
            </div>

            <button class="btn btn-fox-primary w-100 py-3 mb-4 shadow-sm" onclick="sendReset()">
                <i class="bi bi-send-fill me-2"></i> Send Recovery Link
            </button>

            <div id="msg" class="mt-3"></div>

            <div class="text-center mt-4">
                <a asp-controller="Account" asp-action="Login" class="text-decoration-none small fw-bold" style="color: var(--fox-orange-dark);">
                    <i class="bi bi-arrow-left me-1"></i> Back to Login
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    async function sendReset() {
        const email = document.getElementById("email").value;
        const msgDiv = document.getElementById("msg");

        if (!email) {
            msgDiv.innerHTML = "<div class='alert alert-warning border-0 small'>Please enter your email address.</div>";
            return;
        }

        try {
            const res = await fetch('/api/Auth/forgot-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email })
            });

            msgDiv.innerHTML = res.ok
                ? "<div class='alert alert-success border-0 small shadow-sm'>Instructions have been sent to your email. Please check your inbox.</div>"
                : "<div class='alert alert-danger border-0 small shadow-sm'>Could not find an account with that email.</div>";
        } catch (err) {
            msgDiv.innerHTML = "<div class='alert alert-danger border-0 small shadow-sm'>Connection error. Please try again.</div>";
        }
    }
</script>
