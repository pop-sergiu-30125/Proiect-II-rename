@{
    ViewData["Title"] = "Reset Password";
    var email = ViewBag.Email;
    var token = ViewBag.Token;
}

<div class="container mt-5" style="max-width:500px;">

    <h2>Reset Password</h2>

    <input id="newPassword" type="password" class="form-control mb-2" placeholder="New password" />

    <input id="confirmPassword" type="password" class="form-control mb-2" placeholder="Confirm password" />

    <button class="btn btn-success w-100" onclick="reset()">
        Reset password
    </button>

    <div id="msg" class="mt-3"></div>

</div>

<script>
    // const email = "@email";
    const email = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(email));
    // const token = "@token";
    const token = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(token));

    async function reset() {
        const pass = document.getElementById("newPassword").value;
        const confirm = document.getElementById("confirmPassword").value;

        if (pass !== confirm) {
            document.getElementById("msg").innerHTML =
                "<div class='alert alert-danger'>Passwords do not match</div>";
            return;
        }

        const res = await fetch('/api/Auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                email,
                token,
                newPassword: pass
            })
        });

        document.getElementById("msg").innerHTML =
            res.ok
                ? "<div class='alert alert-success'>Password changed</div>"
                : "<div class='alert alert-danger'>Error</div>";
    }
</script>