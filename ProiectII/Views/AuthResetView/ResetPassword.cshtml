@{
    ViewData["Title"] = "New Security Credentials";
}

<div class="fox-split-wrapper">
    <!-- Left Side: Image -->
    <div class="fox-split-image" style="background-image: url('/images/design/login_page_fox.jpg');">
        <div class="fox-image-overlay">
            <h1 class="display-4 fw-bold mb-2">Back to the Den</h1>
            <p class="fs-4 opacity-90">Almost there! Set your new password to regain full access.</p>
        </div>
    </div>

    <!-- Right Side: Form -->
    <div class="fox-split-form">
        <div class="fox-form-card shadow-lg">
            <div class="text-center mb-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                     style="width: 70px; height: 70px; background-color: var(--sky-blue-bg);">
                    <i class="bi bi-shield-lock-fill" style="font-size: 2rem; color: var(--sky-blue-dark);"></i>
                </div>
                <h2 class="fox-title">Reset Password</h2>
                <p class="text-muted small">Choose a strong password for your account.</p>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">New Security Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                        <i class="bi bi-lock-fill text-muted"></i>
                    </span>
                    <input id="pwd" type="password" class="form-control border-2 border-start-0" 
                           placeholder="••••••••" 
                           style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" />
                </div>
            </div>

            <div class="mb-5">
                <label class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Confirm Password</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                        <i class="bi bi-check-circle-fill text-muted"></i>
                    </span>
                    <input id="pwd2" type="password" class="form-control border-2 border-start-0" 
                           placeholder="••••••••" 
                           style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" />
                </div>
            </div>

            <button class="btn btn-fox-primary w-100 py-3 mb-4 shadow-sm" onclick="doReset()">
                <i class="bi bi-check-circle-fill me-2"></i> Update Password
            </button>

            <div id="msg"></div>
        </div>
    </div>
</div>

<script>
    async function doReset() {
        const urlParams = new URLSearchParams(window.location.search);
        const email = urlParams.get('email');
        const token = urlParams.get('token');
        const pwd = document.getElementById("pwd").value;
        const pwd2 = document.getElementById("pwd2").value;
        const msgDiv = document.getElementById("msg");

        if (pwd !== pwd2) {
            msgDiv.innerHTML = "<div class='alert alert-danger border-0 small'>Passwords do not match.</div>";
            return;
        }

        try {
            const res = await fetch('/api/Auth/reset-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email, token, newPassword: pwd })
            });

            if (res.ok) {
                msgDiv.innerHTML = "<div class='alert alert-success border-0 small'>Password updated! Redirecting...</div>";
                setTimeout(() => window.location.href = "/Account/Login", 1500);
            } else {
                const errData = await res.json();
                msgDiv.innerHTML = `<div class='alert alert-danger border-0 small'>${errData.message || 'Error resetting password.'}</div>`;
            }
        } catch (err) {
            msgDiv.innerHTML = "<div class='alert alert-danger border-0 small'>Connection error.</div>";
        }
    }
</script>
