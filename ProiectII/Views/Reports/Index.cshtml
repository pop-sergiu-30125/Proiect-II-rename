@using ProiectII.Models
@model IEnumerable<ProiectII.DTO.CommentsReport.ReportDto>

@{
    ViewData["Title"] = "Reports Management";
    string currentSearch = ViewBag.Search ?? "";
    string currentStatus = ViewBag.Status ?? "all";
    string currentSort = ViewBag.Sort ?? "newest";
}

<div class="fox-full-page">
    <div class="fox-page-header">
        <h1 class="fox-title">Reports Management</h1>
        <p class="fox-subtitle mb-0">Reviewing and tracking all fox sightings reported by the community.</p>
    </div>

    <!-- Filter Bar (Moved to C# / HTML Form) -->
    <div class="fox-card mb-5">
        <form method="get" action="/Reports/Index">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-bold small text-primary">SEARCH REPORTS</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-2 border-end-0" style="border-color: var(--sky-blue-muted);">
                            <i class="bi bi-search text-muted"></i>
                        </span>
                        <input type="text" name="search" class="form-control border-2 border-start-0" 
                               style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0;" 
                               placeholder="Description or reporter..." value="@currentSearch" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-primary">STATUS</label>
                    <select name="status" class="form-select border-2" style="border-radius: 12px; border-color: var(--sky-blue-muted);">
                        <option value="all" selected="@(currentStatus == "all")">All Statuses</option>
                        @foreach (var status in Enum.GetValues<ReportStatus>())
                        {
                            var s = status.ToString().ToLower();
                            <option value="@s" selected="@(currentStatus == s)">@status</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small text-primary">SORT BY DATE</label>
                    <select name="sort" class="form-select border-2" style="border-radius: 12px; border-color: var(--sky-blue-muted);">
                        <option value="newest" selected="@(currentSort == "newest")">Newest First</option>
                        <option value="oldest" selected="@(currentSort == "oldest")">Oldest First</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-fox-primary w-100">Apply</button>
                        <a href="/Reports/Index" class="btn btn-fox-outline" title="Reset Filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </div>
            </div>
        </form>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (!Model.Any())
    {
        <div class="fox-card text-center py-5">
            <h4 class="text-muted">No reports match your current filters.</h4>
            <a href="/Reports/Index" class="btn btn-fox-outline mt-3">Clear all filters</a>
        </div>
    }
    else
    {
        <div class="fox-table-container">
            <div class="table-responsive">
                <table class="table table-hover fox-table mb-0">
                    <thead>
                        <tr>
                            <th>Image</th>
                            <th>Description</th>
                            <th>Coordinates</th>
                            <th>Submitted By</th>
                            <th>Status</th>
                            <th>Time Received</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model)
                        {
                            <tr>
                                <td style="width: 120px;">
                                    @if (!string.IsNullOrEmpty(report.ImageUrl))
                                    {
                                        <img src="@report.ImageUrl" alt="Sighting" class="rounded" style="width: 90px; height: 65px; object-fit: cover; border: 2px solid var(--fox-orange-bg);" />
                                    }
                                    else
                                    {
                                        <div class="bg-light text-muted d-flex align-items-center justify-content-center rounded" style="width: 90px; height: 65px; font-size: 10px; border: 1px dashed var(--fox-orange-primary);">
                                            NO PHOTO
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div class="mb-1"><span class="fox-id-badge">#@report.Id</span></div>
                                    <div class="text-secondary small" style="max-width: 400px; line-height: 1.4;">
                                        @report.Description
                                    </div>
                                </td>
                                <td>
                                    <div class="small">
                                        <span class="text-muted">L:</span> @report.Latitude.ToString("F3")<br />
                                        <span class="text-muted">G:</span> @report.Longitude.ToString("F3")
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-light d-flex align-items-center justify-content-center me-3" style="width: 32px; height: 32px; font-size: 12px; font-weight: bold; color: var(--fox-orange-dark); border: 1px solid var(--fox-orange-muted);">
                                            @(!string.IsNullOrEmpty(report.ReporterName) ? report.ReporterName.Substring(0, 1).ToUpper() : "?")
                                        </div>
                                        <span class="fw-bold" style="color: var(--fox-orange-dark);">@(string.IsNullOrEmpty(report.ReporterName) ? "Guest" : report.ReporterName)</span>
                                    </div>
                                </td>
                                <td>
                                    <form action="/Reports/UpdateStatus" method="post" class="d-flex align-items-center gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@report.Id" />

                                        @{
                                            Enum.TryParse<ReportStatus>(report.StatusName, out var currentStatusEnum);
                                        }

                                        <select name="newStatus" class="form-select form-select-sm" style="width: auto; font-weight: bold; border-color: var(--sky-blue-muted); color: var(--sky-blue-dark);">
                                            @foreach (var status in Enum.GetValues<ReportStatus>())
                                            {
                                                <option value="@status" selected="@(status == currentStatusEnum)">@status</option>
                                            }
                                        </select>

                                        <button type="submit" class="btn btn-sm btn-fox-primary py-1 px-2" style="font-size: 10px;">Update</button>
                                    </form>

                                    <div class="mt-2">
                                        <span class="fox-pill @(report.StatusName == "Pending" ? "fox-pill-warning" : "fox-pill-success")">
                                            @(report.StatusName?.ToUpper() ?? "UNKNOWN")
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold small text-dark">@report.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    <div class="small text-muted">@report.CreatedAt.ToString("HH:mm")</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
