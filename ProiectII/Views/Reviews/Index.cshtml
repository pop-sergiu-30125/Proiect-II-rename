@using ProiectII.DTO.Reviews
@model IEnumerable<AppReviewListItemDto>
@{
    ViewData["Title"] = "App Reviews";
    var stats = ViewBag.Stats as AppReviewPageDto;
    string currentSort = ViewBag.Sort ?? "newest";
    bool isAdmin = User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin");
    bool isAuthenticated = User?.Identity?.IsAuthenticated == true;
}

<style>
    .star-char {
        font-size: 28px;
        cursor: pointer;
        color: #cbd5e1;
        user-select: none;
        transition: 0.2s;
        display: inline-block;
    }
    .star-char:hover { transform: scale(1.2); }
    .star-active { color: #f59e0b; }
</style>

<div class="fox-full-page">
    <div class="container">
        <div class="text-center mb-5">
            <h1 class="fox-title display-5">App Reviews 🦊</h1>
            <p class="text-muted">Share your experience with the Fox Shelter community.</p>
        </div>

        <!-- Stats & Filter Bar -->
        <div class="row g-4 justify-content-center mb-5">
            <div class="col-lg-10">
                <div class="fox-card d-flex flex-wrap align-items-center justify-content-between gap-4 py-3 px-4" style="background-color: var(--sky-blue-bg); border: 1px solid var(--sky-blue-muted);">
                    @if (stats != null)
                    {
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-bold text-primary">Total: @stats.TotalReviews</span>
                            <span class="text-muted">|</span>
                            <span class="fw-bold text-primary">Average: @Html.Raw(RenderStars(stats.AverageRating)) (@stats.AverageRating.ToString("F1"))</span>
                        </div>
                    }

                    <form method="get" action="/Reviews" class="d-flex align-items-center gap-2">
                        <label class="small fw-bold text-muted text-uppercase mb-0">Sort By:</label>
                        <select name="sort" class="form-select form-select-sm border-2" style="border-radius: 10px; width: auto;" onchange="this.form.submit()">
                            <option value="newest" selected="@(currentSort == "newest")">Newest First</option>
                            <option value="oldest" selected="@(currentSort == "oldest")">Oldest First</option>
                            <option value="highest" selected="@(currentSort == "highest")">Highest Rated</option>
                            <option value="lowest" selected="@(currentSort == "lowest")">Lowest Rated</option>
                        </select>
                    </form>
                </div>
            </div>
        </div>

        <!-- Add Review Section -->
        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                @if (isAuthenticated)
                {
                    <div class="fox-card shadow-sm">
                        <h5 class="fox-title mb-3">Add a review</h5>
                        
                        <div id="star-rating" class="mb-3">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span onclick="setRating(@i)" class="star-char" id="star-@i">☆</span>
                            }
                        </div>
                        <input type="hidden" id="review-rating" value="0" />

                        <textarea id="review-comment" class="form-control mb-3 border-2" rows="3" 
                                  style="border-radius: 12px; border-color: var(--sky-blue-muted);"
                                  placeholder="Write your review here..."></textarea>

                        <div class="d-flex align-items-center gap-3">
                            <button class="btn btn-fox-primary px-4" onclick="addReview()">
                                Submit Review
                            </button>
                            <div id="form-msg" class="small"></div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning text-center border-0 shadow-sm" style="border-radius: 15px;">
                        You must be logged in to add a review.
                    </div>
                }
            </div>
        </div>

        <!-- Reviews List -->
        <div class="row g-4" id="reviews-container">
            @if (!Model.Any())
            {
                <div class="col-12 text-center py-5 text-muted">
                    No reviews yet. Be the first to leave one!
                </div>
            }
            else
            {
                @foreach (var review in Model)
                {
                    <div class="col-md-4">
                        <div class="fox-card h-100 shadow-sm">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <b class="fox-title" style="font-size: 1rem;">@review.UserName</b>
                                <span class="badge bg-light text-dark border">@Html.Raw(RenderStars(review.Rating))</span>
                            </div>
                            
                            <p class="text-secondary small mb-3" style="min-height: 50px;">
                                @review.Comment
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top">
                                <small class="text-muted" style="font-size: 0.75rem;">@review.CreatedAt.ToString("MMM dd, yyyy")</small>
                                
                                @if (isAdmin)
                                {
                                    <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none" onclick="hideReview(@review.Id)">
                                        Hide
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setRating(value) {
            document.getElementById("review-rating").value = value;
            for (let i = 1; i <= 5; i++) {
                const star = document.getElementById(`star-${i}`);
                if (i <= value) {
                    star.textContent = "⭐";
                    star.classList.add("star-active");
                } else {
                    star.textContent = "☆";
                    star.classList.remove("star-active");
                }
            }
        }

        async function addReview() {
            const rating = parseInt(document.getElementById("review-rating").value);
            const comment = document.getElementById("review-comment").value.trim();
            const msgDiv = document.getElementById("form-msg");

            if (rating === 0) {
                msgDiv.className = "text-danger";
                msgDiv.innerText = "Please select a rating.";
                return;
            }

            try {
                const res = await fetch('/api/AppReview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ rating, comment })
                });

                if (res.ok) {
                    msgDiv.className = "text-success";
                    msgDiv.innerText = "Review posted!";
                    setTimeout(() => location.reload(), 800);
                } else {
                    const data = await res.json();
                    msgDiv.className = "text-danger";
                    msgDiv.innerText = data.message || "Error posting.";
                }
            } catch (err) {
                msgDiv.innerText = "Network error.";
            }
        }

        async function hideReview(id) {
            const reason = prompt("Reason for hiding this review:");
            if (reason === null) return;

            await fetch(`/api/AppReview/${id}/hide?reason=${encodeURIComponent(reason)}`, {
                method: 'PUT'
            });
            location.reload();
        }
    </script>
}

@functions {
    public string RenderStars(double val)
    {
        string html = "";
        int rounded = (int)Math.Round(val);
        for (int i = 1; i <= 5; i++)
        {
            html += i <= rounded ? "⭐" : "☆";
        }
        return html;
    }
}
