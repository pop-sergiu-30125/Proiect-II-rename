@model ProiectII.DTO.AuthAccount.RegisterDto
@{
    ViewData["Title"] = "Join the Community";
}

<div class="fox-split-wrapper">
    <!-- Left Side: Image (Hidden on mobile) -->
    <div class="fox-split-image fox-split-image-narrow" style="background-image: url('/images/design/login_page_fox.jpg');">
        <div class="fox-image-overlay">
            <h1 class="display-4 fw-bold mb-2">Start Your Journey</h1>
            <p class="fs-4 opacity-90">Join our community and help protect urban wildlife.</p>
            <div class="mt-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-white bg-opacity-25 p-2" style="backdrop-filter: blur(5px);">
                        <i class="bi bi-heart-fill text-white fs-4"></i>
                    </div>
                    <span class="fw-bold">Member of the Den</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Right Side: Registration Form -->
    <div class="fox-split-form fox-split-form-wide">
        <div class="fox-form-card fox-form-card-wide">
            <div class="text-center mb-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                     style="width: 70px; height: 70px; background-color: var(--sky-blue-bg);">
                    <i class="bi bi-person-plus-fill" style="font-size: 2rem; color: var(--sky-blue-dark);"></i>
                </div>
                <h2 class="fox-title">Create Your Account</h2>
                <p class="text-muted">Register to start reporting sightings and apply for adoptions.</p>
            </div>

            <form asp-action="Register" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 small p-3 rounded bg-danger-subtle border-start border-danger border-3"></div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">First Name</label>
                        <input asp-for="FirstName" class="form-control border-2" placeholder="John" 
                               style="border-color: var(--sky-blue-muted); border-radius: 12px; padding: 12px;" required />
                        <span asp-validation-for="FirstName" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Last Name</label>
                        <input asp-for="LastName" class="form-control border-2" placeholder="Doe" 
                               style="border-color: var(--sky-blue-muted); border-radius: 12px; padding: 12px;" required />
                        <span asp-validation-for="LastName" class="text-danger small mt-1"></span>
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6">
                        <label asp-for="Username" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Username</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                                @@
                            </span>
                            <input asp-for="Username" class="form-control border-2 border-start-0" placeholder="johndoe" 
                                   style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" required />
                        </div>
                        <span asp-validation-for="Username" class="text-danger small mt-1"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="BirthDate" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Birth Date</label>
                        <input asp-for="BirthDate" type="date" class="form-control border-2" 
                               style="border-color: var(--sky-blue-muted); border-radius: 12px; padding: 12px;" required />
                        <span asp-validation-for="BirthDate" class="text-danger small mt-1"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                            <i class="bi bi-envelope text-muted"></i>
                        </span>
                        <input asp-for="Email" class="form-control border-2 border-start-0" placeholder="john@example.com" 
                               style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Password" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Security Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                            <i class="bi bi-shield-lock text-muted"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-2 border-start-0" placeholder="••••••••" 
                               style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" required />
                    </div>
                    <div class="form-text small">Ensure your password is at least 8 characters long.</div>
                    <span asp-validation-for="Password" class="text-danger small mt-1"></span>
                </div>

                <button type="submit" class="btn btn-fox-primary w-100 py-3 mb-4 shadow-sm">
                    <i class="bi bi-check-circle-fill me-2"></i> Register Account
                </button>

                <div class="text-center">
                    <p class="text-muted small mb-0">
                        Already part of the den? 
                        <a asp-controller="Account" asp-action="Login" class="fw-bold text-decoration-none" style="color: var(--fox-orange-dark);">Login here</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
