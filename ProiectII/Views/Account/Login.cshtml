@model ProiectII.DTO.AuthAccount.LoginDto
@{
    ViewData["Title"] = "Login";
}

<div class="fox-split-wrapper">
    <!-- Left Side: Image -->
    <div class="fox-split-image" style="background-image: url('/images/design/login_page_fox.jpg');">
        <div class="fox-image-overlay">
            <h1 class="display-4 fw-bold mb-2">Welcome Back</h1>
            <p class="fs-4 opacity-90">Access your Fox Shelter dashboard and manage residents.</p>
            <div class="mt-4">
                <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(255,255,255,0.2); backdrop-filter: blur(5px); border: 1px solid rgba(255,255,255,0.3);">
                    <i class="bi bi-shield-fill-check me-2"></i> Verified Security
                </span>
            </div>
        </div>
    </div>

    <!-- Right Side: Form -->
    <div class="fox-split-form">
        <div class="fox-form-card">
            <div class="text-center mb-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" 
                     style="width: 70px; height: 70px; background-color: var(--fox-orange-bg);">
                    <i class="bi bi-person-lock" style="font-size: 2rem; color: var(--fox-orange-primary);"></i>
                </div>
                <h2 class="fox-title">Member Login</h2>
                <p class="text-muted small">Please enter your credentials</p>
            </div>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-4 small p-2 rounded bg-danger-subtle border-start border-danger border-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                            <i class="bi bi-envelope text-muted"></i>
                        </span>
                        <input asp-for="Email" class="form-control border-2 border-start-0" 
                               placeholder="your@email.com" 
                               style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1"></span>
                </div>

                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label fw-bold small text-uppercase" style="color: var(--sky-blue-dark); letter-spacing: 0.05em;">Password</label>
                        <a href="/AuthResetView/ForgotPassword" class="text-decoration-none small fw-bold" style="color: var(--sky-blue-dark); opacity: 0.8;">Forgot?</a>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-2 border-end-0" style="border-color: var(--sky-blue-muted); border-radius: 12px 0 0 12px;">
                            <i class="bi bi-shield-lock text-muted"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-2 border-start-0" 
                               placeholder="••••••••" 
                               style="border-color: var(--sky-blue-muted); border-radius: 0 12px 12px 0; padding: 12px;" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1"></span>
                </div>

                <button type="submit" class="btn btn-fox-primary w-100 py-3 mb-4 shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Log In
                </button>

                <div class="text-center">
                    <p class="text-muted small mb-0">
                        Don't have an account? 
                        <a asp-controller="Account" asp-action="Register" class="fw-bold text-decoration-none" style="color: var(--fox-orange-dark);">Sign Up</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
