@{
    ViewData["Title"] = "Home";
}

<div class="fox-full-page" style="padding: 0;">
    <!-- Cinematic Full-Width Hero Section -->
    <div class="fox-break-out fox-hero-full text-center" style="background-image: url('/images/design/home_page_fox.jpg');">
        <div class="fox-hero-overlay"></div>
        
        <div class="container" style="z-index: 2;">
            <div class="fox-hero-content shadow-lg">
                <h1 class="fox-title display-3 mb-3" style="letter-spacing: -0.02em;">Fox Shelter 🦊</h1>
                <p class="fs-4 fw-bold mb-4" style="color: var(--fox-orange-dark) !important;">“NO CONCRETE SLOP IN THIS DEN”</p>
                <p class="text-secondary lead mb-5 mx-auto" style="max-width: 600px; font-size: 1.25rem;">
                    Protecting urban wildlife affected by city expansion. Join our community to track, rescue, and provide homes for our residents.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a class="btn btn-fox-primary py-3 px-5 shadow-lg" asp-controller="Foxes" asp-action="Index">
                        Meet the Foxes
                    </a>
                    <a class="btn btn-fox-outline py-3 px-5" asp-controller="Home" asp-action="Map">
                        Track Residents
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Contained Content Below -->
    <div class="container py-5">
        <!-- Quick Actions Row -->
        <div class="row g-4 justify-content-center mb-5 mt-n5" style="position: relative; z-index: 3; margin-top: -60px;">
            <div class="col-md-4">
                <div class="fox-card-soft p-4 h-100 text-center shadow-lg">
                    <div class="mb-3">
                        <i class="bi bi-megaphone-fill" style="font-size: 3rem; color: var(--sky-blue-dark);"></i>
                    </div>
                    <h4 class="fox-title">Report Sighting</h4>
                    <p class="text-secondary small">Saw a fox in distress? Help the community by pinning the exact location on our map.</p>
                    <a class="btn btn-fox-outline mt-3 w-100" asp-controller="Reports" asp-action="Create">Report Now</a>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="fox-card-soft p-4 h-100 text-center shadow-lg">
                    <div class="mb-3">
                        <i class="bi bi-heart-fill" style="font-size: 3rem; color: var(--fox-orange-primary);"></i>
                    </div>
                    <h4 class="fox-title">Apply to Adopt</h4>
                    <p class="text-secondary small">Our residents deserve the best dens. Start the application process to welcome a new member.</p>
                    <a class="btn btn-fox-outline mt-3 w-100" asp-controller="Foxes" asp-action="Index">View Residents</a>
                </div>
            </div>
        </div>

        <!-- Our Mission Section -->
        <div class="row justify-content-center mb-5 pt-5">
            <div class="col-lg-10">
                <div class="fox-card" style="border-left: 8px solid var(--sky-blue-primary);">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="fox-title mb-4 h1">Our Mission</h2>
                            <p class="lead text-secondary mb-4">
                                Fox Shelter is a community-driven platform focused on protecting foxes affected by urban expansion.
                            </p>
                            <p class="text-muted" style="line-height: 1.8;">
                                As cities continue to grow, natural habitats are being reduced or destroyed, forcing wild animals like foxes to adapt to unsafe urban environments. This often leads to road accidents and habitat loss.
                            </p>
                            <p class="text-muted" style="line-height: 1.8;">
                                Through Fox Shelter, you can learn about their stories, track activity, and contribute to a growing network of people who care about wildlife safety.
                            </p>
                        </div>
                        <div class="col-md-4 text-center">
                            <div class="p-4 rounded-circle bg-light d-inline-block shadow-sm" style="border: 4px dashed var(--fox-orange-muted);">
                                <i class="bi bi-shield-check" style="font-size: 5rem; color: var(--fox-orange-primary);"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact & Location Section -->
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="fox-card h-100" style="border-top: 8px solid var(--fox-orange-primary);">
                            <h3 class="fox-title mb-4">Contact The Den</h3>
                            <div class="d-flex align-items-start mb-3">
                                <div class="rounded-circle bg-light p-2 me-3">
                                    <i class="bi bi-geo-alt-fill text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">Location</h6>
                                    <p class="text-muted small mb-0">Hoia-Baciu Forest, Cluj-Napoca, RO 400001</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="rounded-circle bg-light p-2 me-3">
                                    <i class="bi bi-telephone-fill text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">Phone</h6>
                                    <p class="text-muted small mb-0">+40 700 123 456</p>
                                </div>
                            </div>
                            <div class="d-flex align-items-start">
                                <div class="rounded-circle bg-light p-2 me-3">
                                    <i class="bi bi-envelope-at-fill text-primary"></i>
                                </div>
                                <div>
                                    <h6 class="fw-bold mb-0">Electronic Mail</h6>
                                    <p class="text-muted small mb-0">hello@@foxshelter.org</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="fox-card h-100" style="background-color: var(--sky-blue-bg); border: 2px dashed var(--sky-blue-primary);">
                            <h3 class="fox-title mb-3" style="color: var(--sky-blue-dark);">Support Hours</h3>
                            <p class="text-secondary small mb-4">Our dedicated team of caretakers and volunteers are available during these hours to help with sighting reports or adoption inquiries.</p>
                            <ul class="list-unstyled small fw-bold">
                                <li class="d-flex justify-content-between border-bottom border-white py-2">
                                    <span>Monday - Friday</span>
                                    <span class="text-primary">08:00 - 18:00</span>
                                </li>
                                <li class="d-flex justify-content-between border-bottom border-white py-2">
                                    <span>Saturday</span>
                                    <span class="text-primary">09:00 - 14:00</span>
                                </li>
                                <li class="d-flex justify-content-between py-2">
                                    <span>Emergency Sighting</span>
                                    <span class="text-danger">24/7 (Via Website)</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
