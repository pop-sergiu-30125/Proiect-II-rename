<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProiectII</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="/css/fox-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="/ProiectII.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div style="background-color: #add8e6; height: 60px; width: 100%; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; color: #333; margin-bottom: 5px;">
            <div style="font-size: 24px; font-weight: bold;">Fox Shelter Application</div>

            @if (User?.Identity?.IsAuthenticated == true)
            {
                <div style="display: flex; align-items: center; gap: 15px; font-size: 16px;">
                    <span style="font-weight: 500;">Hello, @User.Identity.Name!</span>
                    <a asp-controller="Account" asp-action="Profile" class="text-dark" style="text-decoration: none; font-weight: 500; background-color: #fff; padding: 5px 12px; border-radius: 4px; border: 1px solid #999;">My Profile</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-link text-danger p-0" style="font-weight: bold; text-decoration: none; font-size: 16px;">
                            Logout
                        </button>
                    </form>
                </div>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="text-dark" style="text-decoration: none; font-weight: 500; background-color: #fff; padding: 5px 12px; border-radius: 4px; border: 1px solid #999;">Login</a>
            }
        </div>

        <div style="background-color: #add8e6; height: 40px; width: 100%; display: flex; align-items: center; gap: 20px; padding-left: 20px;">
            <a class="nav-link text-dark" href="/Home/Index" style="font-weight: 500;">Home</a>
            <a class="nav-link text-dark" href="/Home/Map" style="font-weight: 500;">Map</a>
            <a class="nav-link text-dark" href="/Foxes" style="font-weight: 500;">Rescued Foxes</a>
            <a class="nav-link text-dark" href="/Reports/Create" style="font-weight: 500; background-color: #ffcc99; border-radius: 5px;">Report Sighting</a>
            <a class="nav-link text-dark" href="/Home/About" style="font-weight: 500;">About</a>

            @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
            {
                <a class="nav-link text-dark" href="/Account/Users" style="font-weight: 500;">Manage Users</a>

            }

           
        </div>
    </header>

    <div class="container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Fox Shelter Application
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/site.js" asp-append-version="true"></script>
    <script src="/js/auth.js"></script>
    <script>
        function logout() {
        Auth.logout();
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>