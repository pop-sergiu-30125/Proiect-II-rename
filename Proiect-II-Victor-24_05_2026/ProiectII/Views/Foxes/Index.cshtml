<div class="container mt-5">
    <div class="text-center mb-4">
        <h1 class="display-5 fw-bold">Rescued Foxes 🦊</h1>
        <p class="lead">See rescued foxes that are registered in the Fox Shelter system.</p>

        <!-- BUTTON STAFF -->
        <div id="admin-actions">
            @if (User?.Identity?.IsAuthenticated == true &&
                 (User.IsInRole("Admin") || User.IsInRole("Employee") || User.IsInRole("Staff")))
            {
                <a class="btn btn-warning mt-2" href="/Foxes/CreateFox">
                    + Adaugă vulpe
                </a>
            }
        </div>
    </div>

    <div id="fox-container" class="row g-4">
        <div class="text-center w-100">Loading...</div>
    </div>
</div>

<script>
    // ==================== LOAD FOXES ONLY ====================
    async function loadFoxes() {
        const container = document.getElementById('fox-container');

        try {
            const response = await fetch('https://localhost:8443/api/Fox', {
                method: 'GET',
                headers: {
                    'Accept': 'application/json'
                }
            });

            if (!response.ok) throw new Error("Eroare la încărcarea vulpilor");

            const foxes = await response.json();

            container.innerHTML = foxes.map(fox => `
                <div class="col-md-4">
                    <div class="bg-white rounded shadow-sm p-4 h-100 text-center">

                        <img src="https://localhost:8443${fox.imageUrl}"
                             class="img-fluid rounded mb-3"
                             style="height:200px;width:100%;object-fit:cover;" />

                        <h4>${fox.name}</h4>

                        <p class="text-muted">Status: ${fox.statusName}</p>

                        <span class="badge ${getStatusStyle(fox.statusName)} mb-3">
                            ${fox.statusName}
                        </span>

                        <div class="mt-2">
                            <a href="/Foxes/Details/${fox.id}"
                               class="btn btn-outline-dark btn-sm">
                                View details
                            </a>
                        </div>

                    </div>
                </div>
            `).join('');

        } catch (err) {
            container.innerHTML = `<div class="alert alert-danger">${err.message}</div>`;
        }
    }

    function getStatusStyle(status) {
        const s = (status || '').toLowerCase();
        if (s.includes('healthy')) return 'bg-success';
        if (s.includes('treatment') || s.includes('quarantined')) return 'bg-warning text-dark';
        return 'bg-secondary';
    }

    document.addEventListener('DOMContentLoaded', loadFoxes);
</script>